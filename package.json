{
  "name": "ulbi-react-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type:check": "tsc -b",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "stylelint": "npx stylelint \"**/*.scss\"",
    "stylelint:fix": "npx stylelint \"**/*.scss\" --fix",
    "preview": "vite preview",
    "test:run": "vitest --run",
    "test:watch": "vitest",
    "chromatic": "npx chromatic --config-file=./configs/chromatic/chromatic.config.json --project-token=$CHROMATIC_PROJECT_TOKEN --build-script-name=storybook:build",
    "chromatic:rebuild": "npx chromatic --config-file=./configs/chromatic/chromatic.config.json --project-token=$CHROMATIC_PROJECT_TOKEN --build-script-name=storybook:build --force-rebuild",
    "storybook": "storybook dev -p 6006 -c ./configs/storybook",
    "storybook:build": "storybook build -c ./configs/storybook"
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "chromatic": "^18.7.2",
    "eslint": "^10.9.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "playwright": "latest",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.103.1",
    "storybook": "^10.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  }
}
